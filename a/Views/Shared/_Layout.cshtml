<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kiểm tra thường xuyên 1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .banner-header {
            font-family: 'Times New Roman', Times, serif;
            background-color: #0099CC;
            color: #FFFFFF;
            text-align: center;
            padding: 12px 10px;
            font-size: 22px;
            font-weight: bold;
        }

        .menu-bar {
            font-family: 'Times New Roman', Times, serif;
            background-color: #D5F1FF;
            color: #000000;
            text-align: center;
            padding: 8px 10px;
            font-size: 17px;
        }

        .menu-bar a {
            color: #000000 !important;
            text-decoration: none;
            margin: 0 10px;
        }

        .menu-bar a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body style="font-family: 'Times New Roman', Times, serif;">
    <header>
        <!-- Khung trên: Câu 6 -->
        <div class="banner-header">
            KIỂM TRA THƯỜNG XUYÊN 1 - Họ và tên sinh viên
        </div>

        <!-- Khung dưới: Câu 5 & Câu 6 -->
        <div class="menu-bar">
            @Html.ActionLink("Hiển thị danh sách", "Index", "DailyForecast")
            <span>|</span>
            @Html.ActionLink("Nhập thông tin", "Create", "DailyForecast")
        </div>
    </header>

    <div class="container mb-5">
        <main role="main" class="pb-3 pt-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3" style="font-family: 'Times New Roman';">
        <div class="container">
            &copy; 2026 - Kiểm tra thường xuyên 1 - Lập trình web bằng ASP.NET
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
